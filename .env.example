# Use an absolute path to an existing directory. Forward slashes on Windows.
# Windows example: D:/Videos
# Linux/macOS example: /home/your-name/Videos
VIDEO_DIRECTORY=

# Optional Qwen vision service. Use /v1; no endpoint is selected automatically.
# Docker Desktop host service example: http://host.docker.internal:18360/v1
QWEN_BASE_URL=
QWEN_API_KEY=

# Use gemma for ASU-hosted video-frame descriptions and source checks.
VISION_PROVIDER=qwen
VOYAGER_BASE_URL=https://openai.rc.asu.edu/v1
VOYAGER_API_KEY=
# Local browser upload limit: 2 GiB. Videos stay in the persistent uploads volume.
UPLOAD_MAX_BYTES=2147483648
