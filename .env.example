# Absolute path to an existing video folder. Forward slashes on Windows.
# Windows example: D:/Videos
# Linux/macOS example: /home/your-name/Videos
# The app mounts this folder read-only and never writes into it.
VIDEO_DIRECTORY=

# Vision endpoint that receives sampled frames for descriptions and source checks.
# Qwen service base URL. Use /v1; no endpoint is selected automatically.
# Docker Desktop host service example: http://host.docker.internal:18360/v1
QWEN_BASE_URL=
# Secret key for that endpoint. Leave empty if the endpoint needs no key.
QWEN_API_KEY=

# Vision backend for frame descriptions: qwen (default) or gemma (ASU-hosted).
VISION_PROVIDER=qwen
# Gemma backend base URL. Only used when VISION_PROVIDER=gemma.
VOYAGER_BASE_URL=https://openai.rc.asu.edu/v1
# Gemma backend secret key. Leave empty when VISION_PROVIDER=qwen.
VOYAGER_API_KEY=

# Browser upload size cap in bytes. Default: 2147483648 (2 GiB).
# Uploaded videos stay in the local uploads volume.
UPLOAD_MAX_BYTES=2147483648

# Test profile only. Set 1 to run model-backed tests in the test service.
RUN_MODEL_TESTS=0
